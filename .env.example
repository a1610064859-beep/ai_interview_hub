APP_ENV=development
AUTH_REQUIRED=true
AUTH_SESSION_HOURS=12
DATABASE_URL=sqlite:///./data/interview.db
RESUME_UPLOAD_DIR=data/resumes
LLM_USAGE_LOG_PATH=logs/llm_usage.jsonl
LLM_ORCHESTRATION_TIMEOUT_S=15
LLM_SCORING_TIMEOUT_S=60
LEASE_DURATION_SECONDS=30
LEASE_RENEW_INTERVAL_SECONDS=10

# 本地模型不启用；复测包只使用云端 API。
LLM_LOCAL_BASE_URL=
LLM_LOCAL_API_KEY=
LLM_LOCAL_MODEL=

# 可选云端 flash 兜底；留空时只使用旗舰 API。
LLM_FLASH_BASE_URL=
LLM_FLASH_API_KEY=
LLM_FLASH_MODEL=

# OpenAI Chat Completions 兼容 API：复测包默认路由。
LLM_FLAGSHIP_BASE_URL=https://api.deepseek.com
LLM_FLAGSHIP_API_KEY=
LLM_FLAGSHIP_MODEL=deepseek-flash

# TTS 配置 (edge-tts)
TTS_ENABLED=true
TTS_VOICE=zh-CN-XiaoxiaoNeural
TTS_OUTPUT_DIR=data/audio
TTS_TRANSITION_LINES=嗯，我了解了|请继续|谢谢你的回答
TTS_TIMEOUT_S=30

# ASR 配置（T5，键定义见 docs/asr-implementation-spec.md §4；模型名与缓存目录必填）
# 注：ASR_MODEL_CACHE_DIR 同时作为 MODELSCOPE_CACHE 注入 funasr/modelscope 的模型存储路径（E盘项目外）
ASR_ENABLED=true
ASR_PROVIDER=funasr
ASR_MODEL_NAME=paraformer-zh
ASR_DEVICE=cuda
ASR_MODEL_CACHE_DIR=./models/funasr
ASR_TIMEOUT_S=120
ASR_PRELOAD=true
# ffprobe / ffmpeg 各自的最大等待时间；两者都在线程中执行
AUDIO_PROCESS_TIMEOUT_S=15
# 答题整体截止时间；代理须大于此值 + 2 * AUDIO_PROCESS_TIMEOUT_S + 传输余量
ANSWER_TIMEOUT_S=300
# Next 配置在启动/构建时读取（设置在 web 环境中）
API_PROXY_TIMEOUT_MS=360000
ASR_MAX_UPLOAD_MB=20
ASR_SAMPLE_RATE=16000
ASR_TEMP_DIR=
FFMPEG_PATH=./runtime/ffmpeg/bin/ffmpeg.exe
FFPROBE_PATH=./runtime/ffmpeg/bin/ffprobe.exe
XFYUN_APP_ID=
XFYUN_API_KEY=
XFYUN_WS_URL=
# 前端（Next.js）
# NEXT_PUBLIC_API_MODE 只能是 mock 或 real；缺省按 mock。非法值会使 Next 启动失败。
NEXT_PUBLIC_API_MODE=mock
# real 模式必须设置 BACKEND_URL（不要尾斜杠亦可）；缺失会使 Next 启动失败。mock 模式不需要。
BACKEND_URL=http://127.0.0.1:8000
# 桌面一键启动脚本打开和检查的前端地址；本机演示默认使用 3000 端口。
FRONTEND_URL=http://127.0.0.1:3000

# 局域网手机语音测试：LAN_CERT_DIR 指向本机生成的证书目录；仅开放 WLAN 网卡。
LAN_BIND_INTERFACE=WLAN
LAN_HTTPS_PORT=3443
LAN_CERT_PORT=3444
LAN_UPSTREAM_HOST=127.0.0.1
LAN_UPSTREAM_PORT=3000
LAN_CERT_DIR=
