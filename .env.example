APP_ENV=development
DATABASE_URL=sqlite:///./data/interview.db
LLM_USAGE_LOG_PATH=logs/llm_usage.jsonl
LLM_ORCHESTRATION_TIMEOUT_S=6
LLM_SCORING_TIMEOUT_S=60

# 本地编排主模型（契约目标：Qwen3-30B-A3B，经 Ollama OpenAI 兼容端点）
LLM_LOCAL_BASE_URL=http://127.0.0.1:11434/v1
LLM_LOCAL_API_KEY=ollama
LLM_LOCAL_MODEL=qwen3:30b-a3b

# 云端 flash 兜底（DashScope OpenAI 兼容端点）
LLM_FLASH_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FLASH_API_KEY=
LLM_FLASH_MODEL=qwen-flash

# 云端旗舰档：评分 / JD 解析主模型
LLM_FLAGSHIP_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FLAGSHIP_API_KEY=
LLM_FLAGSHIP_MODEL=
